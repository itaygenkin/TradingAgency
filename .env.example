GOOGLE_API_KEY=

# Database Configuration in docker environment
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=trading_db
POSTGRES_USER=
POSTGRES_PASSWORD=

# App Configuration (Used by Worker, Beat, and Flower)
# Notice the hostnames 'db' and 'redis' in the URLs below:
DATABASE_URL=postgresql://<USER>(<PASSWORD>)@db:5432/trading_db
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
